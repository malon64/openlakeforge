#!/bin/sh
set -eu

# A Secret cannot be read across namespaces, so every workload namespace needs
# its own copy of the ingestion-bot credentials the bootstrap job created.
# Copying is deliberately separate from bootstrapping: that job also registers
# services and rotates the bot token, so it must not re-run just because a
# stage was added.
for secret_name in ${secret_names}; do
  if ! kubectl get secret "$secret_name" -n "$NAMESPACE" >/dev/null 2>&1; then
    echo "Source Secret '$secret_name' is missing in '$NAMESPACE'." >&2
    exit 1
  fi

  literals="$(kubectl get secret "$secret_name" -n "$NAMESPACE" \
    -o go-template='{{range $key, $value := .data}}{{$key}}={{$value | base64decode}}{{"\n"}}{{end}}')"

  for target in $WORKLOAD_NAMESPACES; do
    if [ "$target" = "$NAMESPACE" ]; then
      continue
    fi
    set --
    for literal in $literals; do
      set -- "$@" --from-literal="$literal"
    done
    kubectl delete secret "$secret_name" -n "$target" --ignore-not-found
    kubectl create secret generic "$secret_name" -n "$target" "$@"
    echo "Replicated Secret '$secret_name' into '$target'."
  done

  # A stage that turns governance off keeps its namespace, so dropping it from
  # the target list only stops future copies. The copy already there is a live
  # credential and stays valid until the bootstrap job next rotates the token,
  # which a topology change does not do -- so revoke it in the same run that
  # reconciles the targets.
  for revoked in $REVOKED_NAMESPACES; do
    if [ "$revoked" = "$NAMESPACE" ]; then
      continue
    fi
    if kubectl get secret "$secret_name" -n "$revoked" >/dev/null 2>&1; then
      kubectl delete secret "$secret_name" -n "$revoked"
      echo "Revoked Secret '$secret_name' from '$revoked'."
    fi
  done
done
