#!/bin/sh
set -eu

until PGPASSWORD="$PGPASSWORD" psql -h "$PGHOST" -p "$PGPORT" -U "$POSTGRES_USER" -d postgres -c "select 1" >/dev/null 2>&1; do
  sleep 5
done

create_role_and_db() {
  db_name="$1"
  db_user="$2"
  db_password="$3"

  PGPASSWORD="$PGPASSWORD" psql -h "$PGHOST" -p "$PGPORT" -U "$POSTGRES_USER" -d postgres \
    --set=db_name="$db_name" \
    --set=db_user="$db_user" \
    --set=db_password="$db_password" <<'SQL'
  SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', :'db_user', :'db_password')
  WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'db_user')\gexec
  SELECT format('ALTER ROLE %I WITH LOGIN PASSWORD %L', :'db_user', :'db_password')\gexec
  SELECT format('CREATE DATABASE %I OWNER %I', :'db_name', :'db_user')
  WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'db_name')\gexec
SQL
}

%{ for prefix in database_env_prefixes ~}
create_role_and_db "$${${prefix}_NAME}" "$${${prefix}_USER}" "$${${prefix}_PASSWORD}"
%{ endfor ~}
