{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlakeforge.io/schemas/lakehouse/v1alpha3",
  "title": "OpenLakeForge Lakehouse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "name",
    "displayName",
    "description",
    "status",
    "sources",
    "domains",
    "dashboards"
  ],
  "properties": {
    "apiVersion": {"const": "openlakeforge.io/v1alpha3"},
    "kind": {"const": "Lakehouse"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "displayName": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "status": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {"type": "object", "properties": {"products": {"type": "array", "minItems": 1}}},
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "displayName", "description", "status", "silver_tables", "products"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "displayName": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "status": {"type": "string", "minLength": 1},
          "silver_tables": {"$ref": "#/$defs/silverTableGroup"},
          "products": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "displayName",
                "description",
                "status",
                "silver_inputs",
                "gold_tables"
              ],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "displayName": {"type": "string", "minLength": 1},
                "description": {"type": "string"},
                "status": {"type": "string", "minLength": 1},
                "domain": {"type": "string", "minLength": 1},
                "silver_inputs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
                },
                "gold_tables": {"$ref": "#/$defs/tableGroup"}
              }
            }
          }
        }
      }
    },
    "dashboards": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "products"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "products": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
          }
        }
      }
    }
  },
  "$defs": {
    "silverTableGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tables"],
      "properties": {
        "tables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source", "resource"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "source": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "resource": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "description": {"type": "string"}
            }
          }
        }
      }
    },
    "tableGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tables"],
      "properties": {
        "tables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "description": {"type": "string"}
            }
          }
        }
      },
      "not": {"required": ["schema"]}
    }
  }
}
